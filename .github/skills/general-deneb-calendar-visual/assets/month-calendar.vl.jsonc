// =====================================================================================
// MONTH CALENDAR - Deneb (Vega-Lite) specification
// =====================================================================================
// Draws a Sun-Sat month grid and places one plain card per item on its date. A small
// circle on each card shows the item's RAG status - Red / Amber / Green (optional;
// hollow = no status). Days with more items than fit show "+N more"; clicking a day
// opens a panel listing all items.
//
// HEADER ROW (above the grid): month title on the left, a boxed key ("Status: Red Amber
// Green") on the right. The left of the row can instead host Power BI controls laid
// over the visual - a Month Selector slicer as the title and a Month / List toggle
// (see pTitleMode / pControlsPx and references/powerbi-setup.md).
//
// The spec uses fixed ROLE names, not report field names. Rename each field in the
// Deneb Values well ("Rename for this visual") to its role name and the spec works
// unchanged with any report.
//
// -------------------------------------------------------------------------------------
// FIELD ROLES (Values well) - rename each field to exactly this name
// -------------------------------------------------------------------------------------
//   From the 'Deneb Calendar' table (assets/calendar-table.dax) - already named:
//     Date             -> right-click > "Show items with no data"
//     Month Key        yyyymm
//     Week Row         1-6
//     Weekday Number   0 = Sun ... 6 = Sat
//     Day of Month     1-31
//     Is Today         1/0
//   From the item table:
//     Item Key         required-ish: unique ID, keeps two same-named items apart
//     Item Label       required: text on the card
//     Item Category    optional: RAG status text Red / Amber / Green (see CATEGORY COLOURS)
//   All numeric fields: "Don't summarize".
//
// -------------------------------------------------------------------------------------
// SETUP (Power BI Desktop)
// -------------------------------------------------------------------------------------
// 1. Add a Deneb visual; add the fields above to Values and rename them to the roles.
// 2. Edit > Create new > Vega-Lite > Empty, paste this whole file, Apply.
// 3. Settings pane:
//    - Interactivity: Tooltips on; "Expose cross-filtering values for dataset rows" on.
//    - Continuous view: "Enable patching for hosted datasets" on (keeps the day panel
//      open when the visual's own click cross-filters the page).
// 4. Add a single-select slicer on 'Deneb Calendar'[Month Selector] set to
//    "Current Month". The grid always shows ONE month.
// 5. Format the Deneb visual: General > Properties > Padding = 0 on all sides (the
//    header row is positioned from the visual's top edge).
// 6. Optional header controls (slicer as the title + Month / List toggle): set
//    pTitleMode to "note" and pControlsPx to the controls' width, then follow
//    references/powerbi-setup.md > "Header controls".
//
// -------------------------------------------------------------------------------------
// INTERACTION
// -------------------------------------------------------------------------------------
//   Hover a card            -> tooltip.
//   Click a card            -> cross-filter the page to that item.
//   Click a day / "+N more" -> panel listing every item that day.
//   Click outside the panel -> panel closes.
//
// -------------------------------------------------------------------------------------
// HOW THE LAYOUT WORKS
// -------------------------------------------------------------------------------------
// Both axes use grid units, so the month always fits the visual:
//   x: 0 -> 7   one unit per weekday column (0 = Sunday ... 6 = Saturday)
//   y: 0 -> N   one unit per week row (N = 4-6), reversed so row 1 is at the top.
// Each cell is a 1 x 1 box with top-left corner (Weekday Number, Week Row - 1).
// Positions inside a cell are fractions of that box (see LAYOUT PARAMETERS).
// Days outside the month have no rows, so they show config.view.fill.
// The header row is drawn as marks above the grid (negative pixel offsets): its centre
// line sits 58 px above the grid, which with "padding".top = 12 is 30 px below the
// visual's top edge - the same line as 36 px-tall Power BI controls placed at top + 12.
//
// -------------------------------------------------------------------------------------
// THEME TOKENS - BDO theme by default. To re-theme, replace each hex everywhere it
// appears. Every hex below is used for one role only, so find/replace is safe.
// -------------------------------------------------------------------------------------
//   #FFFFFF  surface: day cells, item cards, day panel, key box
//   #F7F6F7  out-of-month cells (BDO light background)
//   #E7E7E7  lines: grid lines, outer border, card border, key border
//   #E6F6FC  today's cell fill (ocean tint)
//   #1183B1  accent: today's day number, open-day outline, "+N more" (dark ocean;
//            BDO red is kept for status only)
//   #404040  titles: month title, panel title, key title (charcoal)
//   #333333  body text: day numbers, card and panel labels, key labels
//   #5B6E7F  secondary text: weekday header, month note (slate)
//   #828282  panel border, "Click outside to close"
//   #B2B2B2  "No status": hollow circle outline
//   Trebuchet MS font (config.font); sizes = TYPE SCALE params.
//   Status colours: CATEGORY COLOURS in LAYER 3 (+ pKeyItems for the key):
//   Red #E81A3B, Amber #FD7E14, Green #54A575.
// =====================================================================================
{
  // Deneb always supplies the Power BI data under the name "dataset".
  "data": {"name": "dataset"},

  // Top padding places the header row's centre 30 px below the visual's top edge
  // (assumes the Deneb visual's own padding is 0).
  "padding": {"top": 12, "left": 5, "right": 5, "bottom": 5},

  // -----------------------------------------------------------------------------------
  // LAYOUT PARAMETERS - (fraction) = share of one calendar cell's height.
  // -----------------------------------------------------------------------------------
  "params": [
    // Max cards drawn per day; extra items are summarised as "+N more".
    {"name": "pMaxCards", "value": 3},
    // (fraction) Strip at the top of each cell for the day number and "+N more".
    {"name": "pHeaderH", "value": 0.22},
    // (fraction) Empty margin below the last card.
    {"name": "pMoreH", "value": 0.03},
    // (fraction) Vertical gap between stacked cards.
    {"name": "pCardGap", "value": 0.02},
    // (fraction of cell width) Left/right inset of cards inside the cell.
    {"name": "pPadX", "value": 0.04},
    // Day panel: height of one item row in pixels, and panel width in day columns.
    {"name": "pPanelRowPx", "value": 22},
    {"name": "pPanelCols", "value": 2.6},
    // Words used in the day panel title, e.g. "Tue 10 Nov · 2 items".
    {"name": "pItemNoun", "value": "item"},
    {"name": "pItemNounPlural", "value": "items"},

    // --- HEADER ROW -------------------------------------------------------------------
    // "full": month title (+ "· Current Month") drawn at the left of the header row.
    // "note": a Month Selector slicer laid over the header is the title; the month name
    //         is drawn next to it only when the slicer says "Current Month".
    {"name": "pTitleMode", "value": "full"},
    // px from the grid's left edge covered by Power BI controls laid over the header
    // (slicer + toggle). The title / month note starts here. 0 = no controls.
    {"name": "pControlsPx", "value": 0},
    // KEY (boxed, top-right). pKeyItems = the CATEGORY COLOURS domain in the same order,
    // without "No status".
    {"name": "pKeyTitle", "value": "Status"},
    {"name": "pKeyItems", "value": ["Red", "Amber", "Green"]},
    // Average character width as a share of the font size - spaces the key entries.
    // Raise it if key labels touch the next circle, lower it if gaps look too wide.
    {"name": "pCharW", "value": 0.55},

    // --- TYPE SCALE (pt -> px, 1 pt = 1.333 px) - one place for every font size -------
    // 16 pt month title | 12 pt key + month note | 10 pt body | 9 pt supporting text.
    {"name": "pFontTitle", "value": 21.33},
    {"name": "pFontKey", "value": 16},
    {"name": "pFontBody", "value": 13.33},
    {"name": "pFontSmall", "value": 12},

    // Month shown in the grid (e.g. 202611): earliest Month Key in the data. Drives the title.
    {"name": "pShownMonth", "expr": "extent(pluck(data('dataset'), 'Month Key'))[0]"}
  ],

  // -----------------------------------------------------------------------------------
  // SHARED TRANSFORMS - applied to every layer below.
  // -----------------------------------------------------------------------------------
  "transform": [
    // Items with no date arrive with a blank Date - they can't be placed on the grid.
    {"filter": "isValid(datum['Date']) && isValid(datum['Week Row'])"},

    // Safety net: a cleared or multi-select month slicer would stack several months on
    // the same cells. Keep only the earliest month present.
    {"joinaggregate": [{"op": "min", "field": "Month Key", "as": "shownMonthKey"}]},
    {"filter": "datum['Month Key'] === datum.shownMonthKey"},

    // Number of week rows in this month (4-6).
    {"joinaggregate": [{"op": "max", "field": "Week Row", "as": "weekRows"}]},

    // Empty days ("Show items with no data") have a blank Item Label.
    {"calculate": "isValid(datum['Item Label']) && datum['Item Label'] !== ''", "as": "hasItem"},
    // Missing or blank Item Category => "No status" (must match the CATEGORY COLOURS domain).
    {"calculate": "isValid(datum['Item Category']) && datum['Item Category'] !== ''", "as": "hasCategory"},
    {"calculate": "datum.hasCategory ? datum['Item Category'] : 'No status'", "as": "categoryLabel"},
    // Order of items within a day (cards, "+N more" and panel all use it).
    {"calculate": "datum['Item Label']", "as": "sortKey"}
  ],

  "layer": [
    // =================================================================================
    // LAYER 1 - DAY CELLS (background + day number)
    // Collapses to one row per day. Owns the x/y scales.
    // Clicking a cell opens the day panel (LAYER 5).
    // =================================================================================
    {
      "transform": [
        {
          "aggregate": [{"op": "count", "as": "rowsOnDay"}],
          "groupby": ["Week Row", "Weekday Number", "Day of Month", "Is Today"]
        },
        {"calculate": "datum['Weekday Number']", "as": "cellLeft"},
        {"calculate": "datum['Weekday Number'] + 1", "as": "cellRight"},
        {"calculate": "datum['Week Row'] - 1", "as": "cellTop"},
        {"calculate": "datum['Week Row']", "as": "cellBottom"},
        // Marks carrying opensPanel = true open the day panel when clicked.
        {"calculate": "true", "as": "opensPanel"}
      ],
      "layer": [
        {
          "mark": {"type": "rect", "cursor": "pointer", "strokeWidth": 2},
          // Which day's panel is open: set by a click on any opensPanel mark, cleared
          // by a click anywhere else.
          "params": [
            {
              "name": "expandedDay",
              "select": {
                "type": "point",
                "fields": ["Week Row", "Weekday Number"],
                "on": "click[event.item && event.item.datum && event.item.datum.opensPanel]",
                "clear": "click[!(event.item && event.item.datum && event.item.datum.opensPanel)]"
              }
            }
          ],
          "encoding": {
            "x": {
              "field": "cellLeft",
              "type": "quantitative",
              "scale": {"domain": [0, 7], "nice": false, "zero": false},
              "axis": null
            },
            "x2": {"field": "cellRight"},
            "y": {
              "field": "cellTop",
              "type": "quantitative",
              "scale": {"reverse": true, "zero": true, "nice": false},
              "axis": null
            },
            "y2": {"field": "cellBottom"},
            "fill": {
              "condition": {"test": "datum['Is Today'] === 1", "value": "#E6F6FC"},
              "value": "#FFFFFF"
            },
            "stroke": {
              "condition": {"param": "expandedDay", "empty": false, "value": "#1183B1"},
              "value": "transparent"
            }
          }
        },
        {
          // Day number, top-left of the cell.
          "mark": {"type": "text", "align": "left", "baseline": "top", "dx": 6, "dy": 5, "fontSize": {"expr": "pFontBody"}},
          "encoding": {
            "x": {"field": "cellLeft", "type": "quantitative", "axis": null},
            "y": {"field": "cellTop", "type": "quantitative", "axis": null},
            "text": {"field": "Day of Month"},
            "color": {
              "condition": {"test": "datum['Is Today'] === 1", "value": "#1183B1"},
              "value": "#333333"
            }
          }
        }
      ]
    },

    // =================================================================================
    // LAYER 2 - GRID LINES
    // Full-length rules so lines also cross the empty out-of-month cells.
    // =================================================================================
    {
      // Vertical lines between weekday columns (x = 1 ... 6).
      "transform": [
        {
          "aggregate": [{"op": "max", "field": "weekRows", "as": "weekRows"}],
          "groupby": ["Weekday Number"]
        },
        {"filter": "datum['Weekday Number'] > 0"},
        // Constant as a field: Vega-Lite can't pair a "datum" start with a field end.
        {"calculate": "0", "as": "lineTop"}
      ],
      "mark": {"type": "rule", "color": "#E7E7E7"},
      "encoding": {
        "x": {"field": "Weekday Number", "type": "quantitative", "axis": null},
        "y": {"field": "lineTop", "type": "quantitative", "axis": null},
        "y2": {"field": "weekRows"}
      }
    },
    {
      // Horizontal lines between week rows (y = 1 ... N-1).
      "transform": [
        {"aggregate": [{"op": "count", "as": "rowsInWeek"}], "groupby": ["Week Row"]},
        {"filter": "datum['Week Row'] > 1"},
        {"calculate": "datum['Week Row'] - 1", "as": "lineY"},
        {"calculate": "0", "as": "lineLeft"},
        {"calculate": "7", "as": "lineRight"}
      ],
      "mark": {"type": "rule", "color": "#E7E7E7"},
      "encoding": {
        "x": {"field": "lineLeft", "type": "quantitative", "axis": null},
        "x2": {"field": "lineRight"},
        "y": {"field": "lineY", "type": "quantitative", "axis": null}
      }
    },

    // =================================================================================
    // HEADER ROW - month title (left) and boxed key (right), centred 58 px above the grid.
    // Text widths can't be measured in Vega-Lite, so key entries are spaced from an
    // estimated width (characters x pFontKey x pCharW). Positions are px from the grid's
    // right edge, converted to grid units (7 columns).
    // =================================================================================
    {
      "transform": [
        {"aggregate": [{"op": "count", "as": "rowsInMonth"}]},
        {"calculate": "0", "as": "headerY"}
      ],
      "layer": [
        {
          // "full": month title. "note": month name only when the slicer says "Current Month".
          "transform": [
            {"calculate": "isValid(pShownMonth) && pShownMonth === year(now()) * 100 + month(now()) + 1", "as": "isCurrentMonth"},
            {"filter": "isValid(pShownMonth) && (pTitleMode === 'full' || datum.isCurrentMonth)"},
            {"calculate": "timeFormat(datetime(floor(pShownMonth / 100), pShownMonth % 100 - 1, 1), '%B %Y')", "as": "monthName"},
            {"calculate": "pTitleMode === 'full' && datum.isCurrentMonth ? datum.monthName + '  \u00B7  Current Month' : datum.monthName", "as": "titleText"},
            {"calculate": "pControlsPx * 7 / width", "as": "titleX"}
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dy": -58,
            "fontSize": {"expr": "pTitleMode === 'full' ? pFontTitle : pFontKey"},
            "fontWeight": {"expr": "pTitleMode === 'full' ? 700 : 400"},
            "color": {"expr": "pTitleMode === 'full' ? '#404040' : '#5B6E7F'"}
          },
          "encoding": {
            "x": {"field": "titleX", "type": "quantitative", "axis": null},
            "y": {"field": "headerY", "type": "quantitative", "axis": null},
            "text": {"field": "titleText"}
          }
        },
        {
          // KEY: entry 0 = pKeyTitle, then one circle per pKeyItems value.
          "transform": [
            {"calculate": "sequence(0, length(pKeyItems) + 1)", "as": "keyIndex"},
            {"flatten": ["keyIndex"]},
            {"calculate": "datum.keyIndex === 0 ? 'title' : 'dot'", "as": "keyKind"},
            {"calculate": "datum.keyKind === 'title' ? pKeyTitle : pKeyItems[datum.keyIndex - 1]", "as": "keyLabel"},
            // Entry width in px: marker (14) + gap (6) + estimated text width; bold title ~8% wider.
            {"calculate": "length(datum.keyLabel) * pFontKey * pCharW * (datum.keyKind === 'title' ? 1.08 : 1) + (datum.keyKind === 'title' ? 0 : 20)", "as": "keyW"},
            {"calculate": "datum.keyW + 16", "as": "keyStep"},
            {
              "window": [{"op": "sum", "field": "keyStep", "as": "keyCum"}],
              "sort": [{"field": "keyIndex", "order": "descending"}]
            },
            // Left edge of the entry, in px from the grid's right edge (12 px box padding).
            {"calculate": "12 + datum.keyCum - 16", "as": "keyLeftPx"},
            {"calculate": "7 - (datum.keyKind === 'title' ? datum.keyLeftPx : datum.keyLeftPx - 20) * 7 / width", "as": "labelX"},
            {"calculate": "7 - (datum.keyLeftPx - 7) * 7 / width", "as": "markerX"},
            {"calculate": "7 - (datum.keyLeftPx + 12) * 7 / width", "as": "boxLeft"},
            {"calculate": "7", "as": "boxRight"},
            // Same field as the cards, so the dots reuse the CATEGORY COLOURS scale.
            {"calculate": "datum.keyLabel", "as": "categoryLabel"}
          ],
          "layer": [
            {
              // Key box: drawn once, from the left-most entry (the title).
              "transform": [{"filter": "datum.keyKind === 'title'"}],
              "mark": {"type": "rect", "fill": "#FFFFFF", "stroke": "#E7E7E7", "strokeWidth": 1, "cornerRadius": 8, "yOffset": -76, "y2Offset": -40},
              "encoding": {
                "x": {"field": "boxLeft", "type": "quantitative", "axis": null},
                "x2": {"field": "boxRight"},
                "y": {"field": "headerY", "type": "quantitative", "axis": null},
                "y2": {"field": "headerY"}
              }
            },
            {
              "transform": [{"filter": "datum.keyKind === 'dot'"}],
              "mark": {"type": "point", "shape": "circle", "filled": true, "size": 160, "opacity": 1, "yOffset": -58},
              "encoding": {
                "x": {"field": "markerX", "type": "quantitative", "axis": null},
                "y": {"field": "headerY", "type": "quantitative", "axis": null},
                "color": {"field": "categoryLabel", "type": "nominal"}
              }
            },
            {
              "transform": [{"filter": "datum.keyKind === 'title'"}],
              "mark": {"type": "text", "align": "left", "baseline": "middle", "dy": -58, "fontSize": {"expr": "pFontKey"}, "fontWeight": 700, "color": "#404040"},
              "encoding": {
                "x": {"field": "labelX", "type": "quantitative", "axis": null},
                "y": {"field": "headerY", "type": "quantitative", "axis": null},
                "text": {"field": "keyLabel"}
              }
            },
            {
              "transform": [{"filter": "datum.keyKind !== 'title'"}],
              "mark": {"type": "text", "align": "left", "baseline": "middle", "dy": -58, "fontSize": {"expr": "pFontKey"}, "color": "#333333"},
              "encoding": {
                "x": {"field": "labelX", "type": "quantitative", "axis": null},
                "y": {"field": "headerY", "type": "quantitative", "axis": null},
                "text": {"field": "keyLabel"}
              }
            }
          ]
        }
      ]
    },

    // =================================================================================
    // WEEKDAY HEADER - Sun ... Sat above each column.
    // A text layer, not an axis: "axis": null on the other layers would hide an axis.
    // =================================================================================
    {
      "transform": [
        {"aggregate": [{"op": "count", "as": "daysInColumn"}], "groupby": ["Weekday Number"]},
        {"calculate": "datum['Weekday Number'] + 0.5", "as": "headerX"},
        {"calculate": "0", "as": "headerY"},
        {"calculate": "['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][datum['Weekday Number']]", "as": "weekdayName"}
      ],
      "mark": {"type": "text", "align": "center", "baseline": "bottom", "dy": -8, "fontSize": {"expr": "pFontBody"}, "fontWeight": 700, "color": "#5B6E7F"},
      "encoding": {
        "x": {"field": "headerX", "type": "quantitative", "axis": null},
        "y": {"field": "headerY", "type": "quantitative", "axis": null},
        "text": {"field": "weekdayName"}
      }
    },

    // =================================================================================
    // LAYER 3 - ITEM CARDS
    // Up to pMaxCards cards per day: plain card + status circle + label.
    // =================================================================================
    {
      "transform": [
        {"filter": "datum.hasItem"},
        {
          "window": [{"op": "row_number", "as": "slot"}],
          "groupby": ["Week Row", "Weekday Number"],
          "sort": [{"field": "sortKey", "order": "ascending"}, {"field": "Item Key", "order": "ascending"}]
        },
        // Items beyond pMaxCards are counted by LAYER 4 instead.
        {"filter": "datum.slot <= pMaxCards"},

        // Card position (grid units): the space below the header strip is shared
        // equally between pMaxCards slots.
        {"calculate": "(1 - pHeaderH - pMoreH) / pMaxCards", "as": "slotH"},
        {"calculate": "datum['Week Row'] - 1 + pHeaderH + (datum.slot - 1) * datum.slotH", "as": "cardTop"},
        {"calculate": "datum.cardTop + datum.slotH - pCardGap", "as": "cardBottom"},
        {"calculate": "datum['Weekday Number'] + pPadX", "as": "cardLeft"},
        {"calculate": "datum['Weekday Number'] + 1 - pPadX", "as": "cardRight"},
        {"calculate": "(datum.cardTop + datum.cardBottom) / 2", "as": "cardMid"}
      ],

      // Inherited by every card sub-layer.
      "encoding": {
        // Dim cards outside the current cross-filter selection (__selected__ is added by
        // Deneb only when cross-filtering is exposed).
        "opacity": {
          "condition": {"test": "datum.__selected__ === 'off'", "value": 0.3},
          "value": 1
        },
        // TOOLTIP - rename titles to the report's wording and add any extra Values-well
        // fields here. Keep in sync with the tooltip in LAYER 5.
        "tooltip": [
          {"field": "Item Label", "title": "Item"},
          {"field": "categoryLabel", "title": "Status"},
          {"field": "Date", "type": "temporal", "title": "Date", "format": "%d %b %Y"}
        ]
      },

      "layer": [
        {
          // Plain card.
          "mark": {"type": "rect", "cornerRadius": 3, "fill": "#FFFFFF", "stroke": "#E7E7E7", "strokeWidth": 1},
          "encoding": {
            "x": {"field": "cardLeft", "type": "quantitative", "axis": null},
            "x2": {"field": "cardRight"},
            "y": {"field": "cardTop", "type": "quantitative", "axis": null},
            "y2": {"field": "cardBottom"}
          }
        },
        {
          // Status circle. "No status" = hollow circle (fill hidden, outline shown).
          "mark": {"type": "point", "shape": "circle", "filled": true, "size": 70, "xOffset": 10, "stroke": "#B2B2B2"},
          "encoding": {
            "x": {"field": "cardLeft", "type": "quantitative", "axis": null},
            "y": {"field": "cardMid", "type": "quantitative", "axis": null},
            // CATEGORY COLOURS - the only place status colours are defined; the key
            // (HEADER ROW) and the panel circles (LAYER 5) reuse this scale. List every
            // Item Category value exactly as it appears in the data, plus "No status",
            // with one colour each (same order). Values missing from the domain get
            // recycled colours. Keep pKeyItems in the same order (without "No status").
            "color": {
              "field": "categoryLabel",
              "type": "nominal",
              "scale": {
                "domain": ["Red", "Amber", "Green", "No status"],
                "range": ["#E81A3B", "#FD7E14", "#54A575", "#B2B2B2"]
              }
            },
            "fillOpacity": {"condition": {"test": "!datum.hasCategory", "value": 0}, "value": 1},
            "strokeWidth": {"condition": {"test": "!datum.hasCategory", "value": 1.5}, "value": 0}
          }
        },
        {
          // Item label, cut off with "…" to fit; full text is in the tooltip.
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 20,
            "fontSize": {"expr": "pFontBody"},
            "color": "#333333",
            "limit": {"expr": "max(width / 7 - 46, 20)"}
          },
          "encoding": {
            "x": {"field": "cardLeft", "type": "quantitative", "axis": null},
            "y": {"field": "cardMid", "type": "quantitative", "axis": null},
            "text": {"field": "Item Label"}
          }
        }
      ]
    },

    // =================================================================================
    // LAYER 4 - "+N MORE"
    // Top-right of a day cell when it has more items than pMaxCards.
    // Hover = names of the hidden items; click = open the day panel.
    // =================================================================================
    {
      "transform": [
        {"filter": "datum.hasItem"},
        // Same numbering as LAYER 3, so slot > pMaxCards = exactly the items without a card.
        {
          "window": [{"op": "row_number", "as": "slot"}],
          "groupby": ["Week Row", "Weekday Number"],
          "sort": [{"field": "sortKey", "order": "ascending"}, {"field": "Item Key", "order": "ascending"}]
        },
        {"filter": "datum.slot > pMaxCards"},
        {
          "aggregate": [
            {"op": "count", "as": "hiddenCount"},
            {"op": "values", "as": "hiddenRows"}
          ],
          "groupby": ["Week Row", "Weekday Number"]
        },
        {"calculate": "'+' + datum.hiddenCount + ' more'", "as": "moreLabel"},
        {"calculate": "join(pluck(datum.hiddenRows, 'Item Label'), ', ')", "as": "hiddenNames"},
        {"calculate": "datum['Weekday Number'] + 1 - pPadX", "as": "moreX"},
        {"calculate": "datum['Week Row'] - 1", "as": "moreY"},
        {"calculate": "true", "as": "opensPanel"}
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dy": 6,
        "fontSize": {"expr": "pFontSmall"},
        "fontWeight": 700,
        "color": "#1183B1",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {"field": "moreX", "type": "quantitative", "axis": null},
        "y": {"field": "moreY", "type": "quantitative", "axis": null},
        "text": {"field": "moreLabel"},
        "tooltip": [{"field": "hiddenNames", "title": "Also on this day"}]
      }
    },

    // =================================================================================
    // LAYER 5 - DAY PANEL
    // Drawn over the grid for the day in expandedDay; lists every item that day.
    // Row height is in pixels (pPanelRowPx), converted to grid units.
    // =================================================================================
    {
      "transform": [
        {"filter": "datum.hasItem"},
        {"filter": {"param": "expandedDay", "empty": false}},
        {
          "window": [{"op": "row_number", "as": "panelRow"}],
          "sort": [{"field": "sortKey", "order": "ascending"}, {"field": "Item Key", "order": "ascending"}]
        },
        {"joinaggregate": [{"op": "count", "as": "dayCount"}]},

        // One week row is (height / weekRows) px tall.
        {"calculate": "pPanelRowPx * datum.weekRows / height", "as": "rowU"},
        // Title (~1.4 rows) + one row per item + close hint (~1.2 rows).
        {"calculate": "(datum.dayCount + 2.6) * datum.rowU", "as": "panelH"},
        // Open at the clicked day, shifted left/up if it would overflow the grid.
        {"calculate": "clamp(datum['Weekday Number'] + 0.05, 0.05, 7 - pPanelCols - 0.05)", "as": "panelLeft"},
        {"calculate": "datum.panelLeft + pPanelCols", "as": "panelRight"},
        {"calculate": "clamp(datum['Week Row'] - 1 + pHeaderH, 0.05, max(datum.weekRows - datum.panelH - 0.05, 0.05))", "as": "panelTop"},
        {"calculate": "datum.panelTop + datum.panelH", "as": "panelBottom"},
        {"calculate": "datum.panelTop + (datum.panelRow + 0.9) * datum.rowU", "as": "rowY"},
        {
          "calculate": "timeFormat(datum['Date'], '%a %d %b') + ' \u00B7 ' + datum.dayCount + ' ' + (datum.dayCount === 1 ? pItemNoun : pItemNounPlural)",
          "as": "panelTitle"
        },
        // Clicks inside the panel must keep it open.
        {"calculate": "true", "as": "opensPanel"}
      ],
      "layer": [
        {
          // Frame, title and close hint - drawn once, from the first row.
          "transform": [{"filter": "datum.panelRow === 1"}],
          "layer": [
            {
              "mark": {"type": "rect", "fill": "#FFFFFF", "stroke": "#828282", "strokeWidth": 1, "cornerRadius": 4},
              "encoding": {
                "x": {"field": "panelLeft", "type": "quantitative", "axis": null},
                "x2": {"field": "panelRight"},
                "y": {"field": "panelTop", "type": "quantitative", "axis": null},
                "y2": {"field": "panelBottom"}
              }
            },
            {
              "mark": {"type": "text", "align": "left", "baseline": "top", "dx": 10, "dy": 7, "fontSize": {"expr": "pFontBody"}, "fontWeight": 700, "color": "#404040"},
              "encoding": {
                "x": {"field": "panelLeft", "type": "quantitative", "axis": null},
                "y": {"field": "panelTop", "type": "quantitative", "axis": null},
                "text": {"field": "panelTitle"}
              }
            },
            {
              "mark": {
                "type": "text",
                "text": "Click outside to close",
                "align": "left",
                "baseline": "bottom",
                "dx": 10,
                "dy": -6,
                "fontSize": {"expr": "pFontSmall"},
                "fontStyle": "italic",
                "color": "#828282"
              },
              "encoding": {
                "x": {"field": "panelLeft", "type": "quantitative", "axis": null},
                "y": {"field": "panelBottom", "type": "quantitative", "axis": null}
              }
            }
          ]
        },
        {
          // One row per item: status circle and label.
          "encoding": {
            // TOOLTIP - keep in sync with LAYER 3.
            "tooltip": [
              {"field": "Item Label", "title": "Item"},
              {"field": "categoryLabel", "title": "Status"},
              {"field": "Date", "type": "temporal", "title": "Date", "format": "%d %b %Y"}
            ]
          },
          "layer": [
            {
              "mark": {"type": "point", "shape": "circle", "filled": true, "size": 50, "xOffset": 16, "stroke": "#B2B2B2"},
              "encoding": {
                "x": {"field": "panelLeft", "type": "quantitative", "axis": null},
                "y": {"field": "rowY", "type": "quantitative", "axis": null},
                "color": {"field": "categoryLabel", "type": "nominal"},
                "fillOpacity": {"condition": {"test": "!datum.hasCategory", "value": 0}, "value": 1},
                "strokeWidth": {"condition": {"test": "!datum.hasCategory", "value": 1.5}, "value": 0}
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 27,
                "fontSize": {"expr": "pFontBody"},
                "color": "#333333",
                "limit": {"expr": "max(pPanelCols * width / 7 - 56, 40)"}
              },
              "encoding": {
                "x": {"field": "panelLeft", "type": "quantitative", "axis": null},
                "y": {"field": "rowY", "type": "quantitative", "axis": null},
                "text": {"field": "Item Label"}
              }
            }
          ]
        }
      ]
    }
  ],

  // -----------------------------------------------------------------------------------
  // THEME - BDO theme; see THEME TOKENS in the header.
  // -----------------------------------------------------------------------------------
  "config": {
    "font": "Trebuchet MS",
    // fill = out-of-month cells; stroke = outer border of the grid.
    "view": {"fill": "#F7F6F7", "stroke": "#E7E7E7"},
    // The key is drawn in the HEADER ROW layer, so the built-in legend is off.
    "legend": {"disable": true}
  }
}
